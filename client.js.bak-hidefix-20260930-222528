/**
 * `dsh-selfwake` · Client 半边：把**注入用的那条消息**收起来。
 *
 * 为什么需要它：叫醒 agent 只有一条路 —— 投一条 user 消息（`agent.followup`）；
 * 那条消息在界面上会出现，看着很怪（用户原话：**把这个隐藏**）。
 *
 * 🔴 2026-09-30 现场记下的三条（都是踩出来的，别再踩）：
 *   ① **前缀必须两边同步**：宿主侧注入前缀从「（自唤醒」改成「（自己开口）」时，
 *      这里没跟着改 → 判定失效 → 整段注入露在界面上。前缀现在集中在 MARKERS。
 *   ② **注入渲染成 `.dsh-recall-bubble`，但这个类不专属我们**：实测同一页面上
 *      10 个 bubble 里有 9 个是用户自己的正常消息（"要上传插件的""等等，都还没测试呢"…）。
 *      所以**绝不能用 `.dsh-recall-bubble{display:none}` 一刀切**（我干过，把用户消息全藏了），
 *      必须**按文本前缀判定**，只收带我们前缀的那些。
 *   ③ 入口必须是 `window.__ModuleLoader__.load({id, factory})` 形态 ——
 *      裸 ESM 会让整个前端 bundle 语法错、App 进不去（手机版栽过一次）。
 *
 * 其余自我约束：全程 try/catch（客户端半边抛错 = 那块 UI 白掉）；只碰判定命中的节点。
 */
window.__ModuleLoader__.load({
  id: 'dsh-selfwake',
  factory() {
    return {
      inject: [],
      apply(ctx) {
        try {
          // 宿主侧注入前缀（改 index.js 的 withPrefix 调用点时，这里必须同步）
          const MARKERS = ['（自己开口）', '（自唤醒'];
          const compact = (s) => String(s || '').replace(/\s+/g, '');
          const isInject = (text) => {
            const t = compact(text);
            return MARKERS.some((m) => t.indexOf(compact(m)) === 0);
          };

          const hide = () => {
            try {
              const nodes = document.querySelectorAll('.dsh-recall-bubble, [data-chat-flow-kind="user"]');
              for (let i = 0; i < nodes.length; i++) {
                const node = nodes[i];
                if (!isInject(node.textContent)) continue;
                node.style.display = 'none';
                // 顺带把它的外层行也收掉（避免留下一条空白占位）
                let row = node.parentElement;
                for (let up = 0; up < 3 && row; up += 1) {
                  if (row.children.length <= 2) {
                    row.style.display = 'none';
                    break;
                  }
                  row = row.parentElement;
                }
              }
            } catch (error) {
              /* 单条失败不影响页面 */
            }
          };

          hide();
          const observer = new MutationObserver(hide);
          observer.observe(document.body, { childList: true, subtree: true });
          ctx.effect(() => () => observer.disconnect());
          console.info('[selfwake] 客户端半边已挂上：只收起「（自己开口）／（自唤醒」开头的注入消息');
        } catch (error) {
          console.info('[selfwake] 客户端半边挂载失败（不影响页面）：' + String((error && error.message) || error));
        }
      },
    };
  },
});
